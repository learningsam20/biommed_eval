# ── LLM ──────────────────────────────────────────────
# openrouter | ollama
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE_EXPANSION=0.3
LLM_TEMPERATURE_ANSWER=0.1

# ── Embeddings (.env-driven) ─────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=64

# ── Vector DB ────────────────────────────────────────
# pinecone (primary, serverless free tier) | qdrant (local fallback)
VECTOR_DB=pinecone

# Pinecone serverless
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_NAME=bioasq-passages
PINECONE_METRIC=cosine
PINECONE_NAMESPACE=bioasq
PINECONE_BATCH_SIZE=100

# Qdrant fallback
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bioasq_passages

# ── Retrieval ────────────────────────────────────────
BM25_K1=1.2
BM25_B=0.75
BM25_INDEX_PATH=data/bm25_index.pkl
LEXICAL_TOP_K=50
DENSE_TOP_K=50
HYBRID_TOP_K=20
FUSION_METHOD=weighted
RRF_K=60
WEIGHT_BM25=0.5
WEIGHT_DENSE=0.5

# ── Query expansion ──────────────────────────────────
# Keep enabled for offline hybrid_expansion/best; UI defaults expansion off for latency
QUERY_EXPANSION_ENABLED=true
EXPANSION_COUNT=2

# ── Eval ─────────────────────────────────────────────
EVAL_QUERY_SET=data/eval_queries_100.json
EVAL_SEED=42
EVAL_OUTPUT_DIR=results
JUDGE_MODEL=same_as_llm
JUDGE_TEMPERATURE=0.0

# ── Server ───────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5268
FRONTEND_URL=http://localhost:5269
LOG_LEVEL=INFO

# ── Hugging Face ──
HF_TOKEN=your_hf_token_here

# ── Data ─────────────────────────────────────────────
HF_DATASET_ID=rag-datasets/rag-mini-bioasq
DATA_DIR=data
